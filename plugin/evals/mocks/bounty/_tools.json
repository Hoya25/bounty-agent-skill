{
  "tools": [
    {
      "name": "get_bounty",
      "title": "Get a store's bounty",
      "description": "Read what buying at a store earns the shopper, from the store's own published Open Bounty Schema declaration (its /.well-known/bounty.json, or the object its <link rel=\"bounty\"> points to). Returns status (valid, invalid or unknown), earn_display (the store's own sentence, exactly as published), the program, the resolved object, where it was found and whether it is signed. \"unknown\" means the store publishes no declaration; it does not mean purchases earn nothing. Read-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "The store's domain, e.g. shop.example"
          },
          "product": {
            "type": "string",
            "description": "Optional: an https product page URL on that domain, to check whether that product is covered"
          }
        },
        "required": [
          "domain"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "unknown"
            ]
          },
          "earn_display": {
            "type": "string"
          },
          "program": {
            "type": "object"
          },
          "active": {
            "type": "boolean"
          },
          "found_at": {
            "type": "string"
          },
          "object_url": {
            "type": "string"
          },
          "signature": {
            "type": "object"
          },
          "object": {
            "type": "object"
          },
          "product": {
            "type": "object"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "withheld": {
            "type": "string"
          }
        },
        "required": [
          "domain",
          "status"
        ]
      },
      "annotations": {
        "title": "Get a store's bounty",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "search_stores",
      "title": "Search the store index",
      "description": "Search the NCTR Alliance index of 6,000+ stores where members earn on purchases, by store name or keyword. Returns up to 10 matching stores, each with its slug, name, earn_display (the earn sentence), program, listed_by (program: the program settles it; index: the index lists it) and verification (how the listing was checked), plus total, the number of matches. A store not in the index may still publish its own declaration: get_bounty checks any store directly. Read-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "A store name or keyword, e.g. \"outfitters\""
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "stores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "earn_display": {
                  "type": "string"
                },
                "program": {
                  "type": "string"
                },
                "listed_by": {
                  "type": "string"
                },
                "verification": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "name",
                "earn_display"
              ]
            }
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "query",
          "total",
          "stores"
        ]
      },
      "annotations": {
        "title": "Search the store index",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
